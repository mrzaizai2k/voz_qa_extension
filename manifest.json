{
  "manifest_version": 3,
  "name": "VOZ Thread QA",
  "version": "1.0.0",
  "description": "Crawl and ask questions about VOZ forum threads using AI",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://voz.vn/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://voz.vn/t/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
